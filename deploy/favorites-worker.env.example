# The worker's environment (docs/POLYMARKET.md, "The loop off the scheduled runs").
# Everything the scheduled run's Refresh step has, less the ingest keys.
# One NAME=value per line; a value with spaces goes in double quotes.

# The owner key: seals the live ledger and the owner page's record.
ATLAS_OWNER_KEY=

# Polymarket US's key id and secret key (polymarket.us/developer): previews, balances, orders.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET=

# The live step (atlas/polymarket/orders.py): unset, dry or live; live sends only with the
# arming phrase the module states, in double quotes. Start with dry.
POLYMARKET_US_LIVE=dry
POLYMARKET_US_ARMED=
ATLAS_LIVE_BANKROLL=

# The caps, the stop and the floor; unset, the module's own hold ($25 an order, $100 a day,
# $250 open, a $50 stop over three days, a floor at half the bankroll).
MAX_ORDER_DOLLARS=
MAX_DAY_DOLLARS=
MAX_OPEN_DOLLARS=
LOSS_STOP_DOLLARS=
BALANCE_FLOOR=

# Which rules the live step takes here. The worker places the favorites rule's orders; the
# scheduled run still places the model's when its positions are logged.
LIVE_RULES=favorites
# Late positions only (the default). `any` widens it to every crossing.
LIVE_PHASE=late

# The branch the record is pushed to; the checkout's own when unset.
ATLAS_WORKER_BRANCH=
