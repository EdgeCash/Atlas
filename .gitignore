__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Warehouse artifacts are reproducible from source; only tiny manifests are tracked.
data/raw/**
data/staging/**
data/warehouse/**
!data/**/.gitkeep
!data/**/MANIFEST.json

# The site is generated from the warehouse and the tracking store in seconds.
# The generator is the source of truth; the output is not committed.
/site/
/data/site/

# Operational state: rewritten by every scheduled task. Mostly derived from
# nothing but the clock, so it is not worth versioning - except freshness.json,
# which the build reads back to stamp every page. On the GitHub Actions path a
# poll runs in a fresh container and would otherwise publish a board that had
# never heard of the heavy refresh, so that one file is tracked and the publish
# workflow commits it. The conflict this comment used to worry about is handled
# by the same rebase-and-retry the tracking store already uses.
/data/ops/*
!/data/ops/freshness.json

# Backups of the live record. Machine state, and the whole point of them is
# that a copy lives somewhere other than this repository.
/data/backups/

# DFS slate output: projections and the owner's lineups. Never committed -
# the owner page publishes them only encrypted (docs/MODEL_PLAN_DFS.md, step 6).
/data/dfs/

# The owner page's curated plays box: ciphertext, rebuilt by every run from
# the sealed record in tracking/owner_plays/ (atlas/owner/plays.py).
/data/owner/

# The reader counter's local wrangler state and secrets (counter/)
counter/.wrangler/
counter/.dev.vars
counter/node_modules/
