__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Warehouse artifacts are reproducible from source; only tiny manifests are tracked.
data/raw/**
data/staging/**
data/warehouse/**
!data/**/.gitkeep
!data/**/MANIFEST.json

# The site is generated from the warehouse and the tracking store in seconds.
# The generator is the source of truth; the output is not committed.
/site/
/data/site/

# Operational state: rewritten by every scheduled task, derived from nothing
# but the clock. The site falls back gracefully when it is absent, and
# committing it would produce a conflict on every run.
/data/ops/
